@import "tailwindcss";

@layer base {
  body {
    font-family: 'Quicksand', 'Nunito', sans-serif;
  }
}

/* Custom Fonts */
.font-script {
  font-family: 'Great Vibes', cursive;
}

.font-dancing {
  font-family: 'Dancing Script', cursive;
}

.font-display {
  font-family: 'Playfair Display', serif;
}

.font-sans-dreamy {
  font-family: 'Quicksand', 'Nunito', sans-serif;
}

/* Glassmorphism Classes */
.glass-panel {
  background: rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 8px 32px 0 rgba(240, 190, 210, 0.2);
}

.glass-panel-dark {
  background: rgba(230, 210, 240, 0.55);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 8px 32px 0 rgba(220, 180, 230, 0.25);
}

.glass-panel-ultra {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 12px 40px 0 rgba(240, 190, 210, 0.3);
}

/* Glow Text Shadows */
.text-glow-pearl {
  text-shadow: 
    0 0 8px rgba(255, 255, 255, 0.8),
    0 0 16px rgba(255, 210, 230, 0.6),
    0 0 24px rgba(220, 200, 255, 0.4);
}

.text-glow-pink {
  text-shadow: 
    0 0 10px rgba(255, 182, 193, 0.9),
    0 0 20px rgba(255, 105, 180, 0.5),
    0 0 30px rgba(255, 192, 203, 0.3);
}

/* Wavy Liquid Border Animation */
@keyframes wave-rotate {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.animate-wave-rotate {
  animation: wave-rotate 10s linear infinite;
}

/* Liquid Wave Border Generator */
.liquid-border {
  border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
  background: linear-gradient(45deg, #BCECAC, #FFD1DC, #E6E6FA);
  background-size: 200% 200%;
  animation: liquid-morph 8s ease-in-out infinite, wave-rotate 12s linear infinite;
}

@keyframes liquid-morph {
  0% {
    border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
    background-position: 0% 50%;
  }
  50% {
    border-radius: 30% 60% 70% 40% / 50% 60% 30% 6% 0%;
    background-position: 100% 50%;
  }
  100% {
    border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
    background-position: 0% 50%;
  }
}

/* Elegant Flower/Leaf Custom Scrollbar */
.custom-scroll::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

.custom-scroll::-webkit-scrollbar-track {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 10px;
}

.custom-scroll::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, #FFD1DC 0%, #E6E6FA 100%);
  border-radius: 10px;
}

.custom-scroll::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(180deg, #ffb3c6 0%, #d8b4f8 100%);
}

/* Sparkling Sparkles */
.sparkle-slow {
  animation: float-sparkle 6s ease-in-out infinite;
}

@keyframes float-sparkle {
  0%, 100% {
    transform: translateY(0px) scale(0.8) rotate(0deg);
    opacity: 0.3;
  }
  50% {
    transform: translateY(-20px) scale(1.2) rotate(180deg);
    opacity: 0.95;
  }
}

/* Butterflies and Petals falling classes */
.petal {
  position: absolute;
  background: radial-gradient(circle, #ffe3e8 0%, #ffd1dc 70%, rgba(255,255,255,0) 100%);
  border-radius: 50% 0% 50% 50%;
  opacity: 0.7;
  pointer-events: none;
  z-index: 1;
}

/* Tulip pulsing glow */
.tulip-glow {
  filter: drop-shadow(0 0 6px rgba(255, 182, 193, 0.8));
  animation: tulip-pulse 2s ease-in-out infinite alternate;
}

@keyframes tulip-pulse {
  0% {
    filter: drop-shadow(0 0 4px rgba(255, 182, 193, 0.6)) scale(1);
  }
  100% {
    filter: drop-shadow(0 0 12px rgba(255, 105, 180, 0.9)) scale(1.08);
  }
}

/* Hidden Scrollbar helper */
.hide-scrollbar {
  -ms-overflow-style: none;  /* IE and Edge */
  scrollbar-width: none;  /* Firefox */
}
.hide-scrollbar::-webkit-scrollbar {
  display: none; /* Chrome, Safari and Opera */
}
